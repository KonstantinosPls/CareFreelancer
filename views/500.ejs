<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <h1 class="display-1 text-danger">500</h1>
            <h2 class="mb-4">Server Error</h2>
            <p class="lead text-muted">
                <%= typeof message !== 'undefined' && message ? message : 'Something went wrong on our end. Please try again later.' %>
            </p>

            <div class="mt-4">
                <a href="javascript:history.back()" class="btn btn-outline-secondary me-2">Go Back</a>
                <a href="/" class="btn btn-primary">Go Home</a>
            </div>

            <p class="text-muted small mt-4">
                If this problem persists, please contact support.
            </p>

            <% if (typeof error !== 'undefined' && error && error.stack) { %>
                <div class="mt-4 text-start">
                    <div class="alert alert-secondary">
                        <h6 class="alert-heading">
                            <i class="bi bi-bug"></i> Debug Information (Development Mode)
                        </h6>
                        <hr>
                        <pre class="mb-0" style="white-space: pre-wrap; font-size: 12px;"><%= error.stack %></pre>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
