<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <h1 class="display-1 text-warning">400</h1>
            <h2 class="mb-4">Bad Request</h2>
            <p class="lead text-muted"><%= typeof message !== 'undefined' ? message : 'The request could not be understood by the server.' %></p>

            <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
                <div class="alert alert-warning text-start mt-4">
                    <strong>Please fix the following:</strong>
                    <ul class="mb-0 mt-2">
                        <% errors.forEach(error => { %>
                            <li><%= error.message || error.msg || error %></li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>

            <div class="mt-4">
                <a href="javascript:history.back()" class="btn btn-outline-secondary me-2">Go Back</a>
                <a href="/" class="btn btn-primary">Go Home</a>
            </div>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
