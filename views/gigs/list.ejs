<%- include('../partials/header') %>
  <%- include('../partials/navbar') %>

    <main class="container mt-5">
      <h1 class="mb-4">Browse Gigs</h1>

      <% if (gigs && gigs.length> 0) { %>
        <div class="row">
          <% gigs.forEach(gig=> { %>
            <div class="col-md-4 mb-4">
              <div class="card h-100">
                <% if (gig.images && gig.images.length> 0) { %>
                  <img src="<%= gig.images[0] %>" class="card-img-top" alt="<%= gig.title %>"
                    style="height: 200px; object-fit: cover;">
                  <% } else { %>
                    <img src="https://via.placeholder.com/300x200?text=No+Image" class="card-img-top" alt="No image">
                    <% } %>
                      <div class="card-body">
                        <h5 class="card-title">
                          <%= gig.title %>
                        </h5>
                        <p class="card-text text-truncate">
                          <%= gig.description %>
                        </p>
                        <p class="mb-1">
                          <span class="badge bg-primary">
                            <%= gig.category %>
                          </span>
                        </p>
                        <p class="mb-1">
                          <strong>By:</strong>
                          <%= gig.freelancerId ? gig.freelancerId.username : 'Unknown' %>
                        </p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                          <h5 class="text-success mb-0">€<%= gig.price %>
                          </h5>
                          <a href="/gigs/<%= gig._id %>" class="btn btn-primary btn-sm">View Details</a>
                        </div>
                      </div>
              </div>
            </div>
            <% }) %>
        </div>
        <% } else { %>
          <div class="alert alert-info text-center">
            <h4>No gigs available yet</h4>
            <p>Be the first to create a gig!</p>
            <% if (user && (user.role==='freelancer' || user.role==='both' )) { %>
              <a href="/gigs/create" class="btn btn-primary">Create a Gig</a>
              <% } %>
          </div>
          <% } %>
    </main>

    <%- include('../partials/footer') %>