<!-- Cookie Consent Banner -->
<div id="cookieConsent" class="cookie-consent" style="display: none;">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between">
      <div class="cookie-text mb-3 mb-md-0">
        <i class="bi bi-shield-lock me-2"></i>
        <span>We use cookies to enhance your experience. By continuing to use this site, you agree to our use of cookies for session management and security.</span>
        <a href="#" class="text-white ms-1" data-bs-toggle="modal" data-bs-target="#cookiePolicyModal">Learn more</a>
      </div>
      <div class="cookie-buttons">
        <button id="acceptCookies" class="btn btn-light btn-sm me-2">Accept</button>
        <button id="declineCookies" class="btn btn-outline-light btn-sm">Decline</button>
      </div>
    </div>
  </div>
</div>

<!-- Cookie Policy Modal -->
<div class="modal fade" id="cookiePolicyModal" tabindex="-1" aria-labelledby="cookiePolicyModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="cookiePolicyModalLabel">Cookie Policy</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <h6>What are cookies?</h6>
        <p>Cookies are small text files stored on your device when you visit a website. They help the website remember your preferences and improve your experience.</p>

        <h6>How we use cookies</h6>
        <p>CareFreelancer uses cookies for:</p>
        <ul>
          <li><strong>Session Management:</strong> To keep you logged in and remember your preferences during your visit.</li>
          <li><strong>Security:</strong> To protect against cross-site request forgery (CSRF) attacks.</li>
          <li><strong>Remember Me:</strong> To keep you logged in for longer periods if you choose this option.</li>
        </ul>

        <h6>Your choices</h6>
        <p>You can accept or decline cookies. If you decline, some features may not work properly (e.g., you won't be able to log in).</p>

        <p class="text-muted small mb-0">This is an academic project for CCS2210 Web Programming at the University of York.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

