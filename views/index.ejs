      <div class="col-md-4 mb-4 mb-md-0">
        <div class="stat-item">
          <h2 class="stat-number text-primary">500+</h2>
          <p class="text-muted mb-0">Talented Freelancers</p>
        </div>
      </div>
      <div class="col-md-4 mb-4 mb-md-0">
        <div class="stat-item">
          <h2 class="stat-number text-primary">1,000+</h2>
          <p class="text-muted mb-0">Services Available</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-item">
          <h2 class="stat-number text-primary">98%</h2>
          <p class="text-muted mb-0">Client Satisfaction</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Script to show/hide navbar search based on scroll -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const navbarSearch = document.getElementById('navbarSearch');
  const heroSearch = document.querySelector('.hero-search');

  if (navbarSearch && heroSearch) {
    function checkScroll() {
      const heroSearchRect = heroSearch.getBoundingClientRect();
      const navbarHeight = document.querySelector('.navbar').offsetHeight || 70;

      // Show navbar search when hero search is scrolled past the navbar
      if (heroSearchRect.bottom < navbarHeight) {
        navbarSearch.classList.add('visible');
      } else {
        navbarSearch.classList.remove('visible');
      }
    }

    window.addEventListener('scroll', checkScroll);
    checkScroll(); // Run on load
  }
});
</script>

