<!-- How It Works Section -->
<section class="how-it-works-section py-5 bg-light">
  <div class="container">
    <h2 class="text-center mb-5">How It Works</h2>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="text-center">
          <div class="step-icon mb-3">
            <i class="bi bi-person-plus"></i>
          </div>
          <h5>1. Create an Account</h5>
          <p class="text-muted">Sign up as a freelancer, client, or both. It's free and takes just a minute.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="text-center">
          <div class="step-icon mb-3">
            <i class="bi bi-search"></i>
          </div>
          <h5>2. Find or Post Services</h5>
          <p class="text-muted">Browse thousands of gigs or create your own to showcase your skills.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="text-center">
          <div class="step-icon mb-3">
            <i class="bi bi-briefcase"></i>
          </div>
          <h5>3. Get Work Done</h5>
          <p class="text-muted">Collaborate securely and get quality work delivered on time.</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-5">
      <% if (!user) { %>
        <a href="/auth/register" class="btn btn-primary btn-lg me-2">Get Started Free</a>
        <a href="/gigs" class="btn btn-outline-primary btn-lg">Browse Gigs</a>
      <% } else { %>
        <a href="/gigs" class="btn btn-primary btn-lg me-2">Browse Gigs</a>
        <% if (user.role === 'freelancer' || user.role === 'both') { %>
          <a href="/gigs/create" class="btn btn-success btn-lg">Post a Gig</a>
        <% } %>
      <% } %>
    </div>
  </div>
</section>

<!-- Stats Section -->
